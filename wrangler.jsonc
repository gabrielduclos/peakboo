{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main",
  "main": "worker.mjs",
  "triggers": {"crons": ["*/5 * * * *"]},
  "preview_urls": false,
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
