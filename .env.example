DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:5173
PORT=3001
# Optional: separate API origin when deploying the frontend alone.
VITE_API_URL=
# Canonical frontend origin for invitation links and QR codes.
VITE_APP_URL=https://main.peakboo.workers.dev

# Optional private Cloudflare R2 bucket; configure all four together on the API only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: eu, us, fedramp; leave blank for default jurisdiction.
R2_JURISDICTION=

# Push is opt-in; never place a private key in frontend variables.
PUSH_ENABLED=false
# Optional stable 32-byte base64url key, otherwise derived via HKDF from BETTER_AUTH_SECRET.
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=https://main.peakboo.workers.dev
